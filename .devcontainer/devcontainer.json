{
  "name": "Receipts workshop",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt && cp -n .env.example .env",
  "secrets": {
    "MISTRAL_API_KEY": {
      "description": "Your Mistral API key. Or leave this empty and edit .env instead."
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
